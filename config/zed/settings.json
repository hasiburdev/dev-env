// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cat\\b"
            },
            {
              "pattern": "^npx\\s+tsc(\\s|$)"
            },
            {
              "pattern": "^grep\\s+fashion\\-header\\|Header/index(\\s|$)"
            },
            {
              "pattern": "^pnpm\\s+generate:types(\\s|$)"
            },
            {
              "pattern": "^grep\\s+not\\-found(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            }
          ]
        }
      }
    },
    "play_sound_when_agent_done": "always",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    },
    "model_parameters": []
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "Fleet Dark Purple"
  }
}
