// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "bold_folder_labels": false,
    "entry_spacing": "comfortable",
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot"
  },
  "agent": {
    "dock": "left",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cat\\b"
            },
            {
              "pattern": "^npx\\s+tsc(\\s|$)"
            },
            {
              "pattern": "^grep\\s+fashion\\-header\\|Header/index(\\s|$)"
            },
            {
              "pattern": "^pnpm\\s+generate:types(\\s|$)"
            },
            {
              "pattern": "^grep\\s+not\\-found(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            }
          ]
        }
      }
    },
    "play_sound_when_agent_done": "always",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    },
    "model_parameters": []
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "One Dark Pro"
  },

  // New
  //
  "colorize_brackets": true,
  "code_lens": "on",
  "toolbar": {
    "code_actions": true
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "gutter": {
    "line_numbers": true
  },
  "cursor_blink": true,
  "show_whitespaces": "all",
  "vertical_scroll_margin": 4,

  // Editor horizontal scroll margin (nvim's sidescrolloff=8)
  // Columns to keep left/right of cursor
  // https://zed.dev/docs/reference/all-settings#horizontal-scroll-margin
  "horizontal_scroll_margin": 8,

  "format_on_save": "on",
  "preferred_line_length": 100,
  "soft_wrap": "editor_width",

  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },

  "inlay_hints": {
    "enabled": true
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // Above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules"
  ]
}
